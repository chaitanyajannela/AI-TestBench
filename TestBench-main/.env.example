APP_NAME=AI TestBench
APP_ENV=development
DATABASE_URL=sqlite:///./testbench.db
API_V1_PREFIX=/api/v1
CREDENTIAL_ENCRYPTION_KEY=
REQUEST_TIMEOUT_SECONDS=20
ALLOW_PRIVATE_CHATBOT_HOSTS=false
CORS_ORIGINS=http://localhost:3000

# Optional open-source integrations
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPEVAL_MODEL=
GISKARD_MODEL=openai/gpt-4o-mini
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
TESTBENCH_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
